# Application. Use production whenever the service is exposed through a real domain.
PORT=3456
NODE_ENV=development

# Optional comma-separated browser origins allowed to call the API across origins.
# Same-origin deployment through Nginx needs no value. Do not use a wildcard.
# CORS_ORIGINS=https://app.example.com

# Optional bootstrap codes. They are converted to a fixed three-day invite on
# first successful login. To create a registered invite, run
# `npm run invite:generate -- user` or `npm run invite:generate -- admin`.
# Invites can also be created by an authenticated admin through POST
# /admin/invites. Keep real values only in server/.env or deployment secrets.
INVITE_CODES=
ADMIN_INVITE_CODES=replace-with-a-random-bootstrap-admin-invite

# Set to true only when the site is served over HTTPS; Secure session cookies
# are otherwise dropped by browsers on plain-HTTP deployments.
SESSION_COOKIE_SECURE=false

# PostgreSQL: required for production users, recommendation history, feedback
# and admin data persistence. Do not commit a real credential.
DATABASE_URL=postgresql://modelcompare:CHANGE_ME@127.0.0.1:5432/modelcompare

# Parent Agent (MiniMax Anthropic-compatible API)
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=
MINIMAX_PRIMARY_MODEL=MiniMax-M2.7
MINIMAX_FALLBACK_MODEL=MiniMax-M3

# Real-time image evaluation; shares MINIMAX_API_KEY. Must expose /image_generation.
MINIMAX_IMAGE_BASE_URL=https://api.minimax.cn/v1

# Text evaluation — DeepSeek V4 Flash / Pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Image evaluation — Doubao Seedream on Volcengine Ark
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=

# Local BGE-M3 embedding service
RAG_EMBEDDING_URL=http://127.0.0.1:8091

# Comma-separated official document hostnames that administrators may ingest.
# Defaults to the vendor source registry and bundled knowledge-source hosts when
# omitted. Do not use a wildcard.
# KNOWLEDGE_ALLOWED_HOSTS=developers.openai.com,docs.anthropic.com
# KNOWLEDGE_MAX_SOURCE_BYTES=2000000

# Jev is off by default; set visible or shadow to enable auxiliary scoring.
JEV_MODE=off
# Existing local env files may use jev_key or JEV_KEY instead.
# TYPESAFE_API_KEY takes precedence when more than one spelling is set.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MIN_CONFIDENCE=0.6
JEV_TIMEOUT_MS=10000
RAG_TIMEOUT_MS=1500
RECOMMENDATION_TIMEOUT_MS=8000
# Optional trusted conversion snapshot: from/to/rate/sourceUrl/verifiedAt.
RECOMMENDATION_FX_SNAPSHOT=
