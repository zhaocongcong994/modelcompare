{
  "name": "model-compare-server",
  "version": "1.0.0",
  "description": "Live model-catalog API + Share Image Server for ModelCompare",
  "main": "api.js",
  "type": "module",
  "scripts": {
    "api": "node api.js",
    "share": "node share.js",
    "dev": "node api.js & node share.js",
    "worker": "node sync-worker.js",
    "rag:ingest": "node ingest-knowledge.js",
    "sync": "node sync-worker.js --once",
    "prompts:export": "node export-evaluation-prompts.js",
    "prompts:sync": "node export-evaluation-prompts.js --sync",
    "prompts:apply-local": "node apply-evaluation-presets.js --apply-local",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:backfill:recommendations": "node backfill-recommendation-ids.js",
    "evaluation-assets:backfill": "node backfill-evaluation-images.js",
    "invite:generate": "node generate-invite.js",
    "test:isolation": "node isolation-api-test.js",
    "test:invite-expiry": "node invite-expiry-api-test.js",
    "test:evaluation": "node evaluation-api-test.js",
    "db:migrate:anonymous": "node migrate-anonymous-users.js && prisma db push --accept-data-loss",
    "test:rules": "node --test recommendation-test.js judge/typesafe-test.js judge/validation-test.js",
    "test:iteration": "node iteration-api-test.js",
    "test:frontend": "node frontend-iteration-test.js",
    "test:annotation": "node annotation-test.js",
    "test:prompt-display": "node prompt-display-test.js",
    "dev:local": "node ../scripts/local-dev.mjs start",
    "dev:local:stop": "node ../scripts/local-dev.mjs stop",
    "jev:dry-run": "node judge/validation.js dry-run ../validation/jev/samples.jsonl"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.16.3",
    "playwright": "^1.45.0",
    "prisma": "^7.9.1"
  }
}
